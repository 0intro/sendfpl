<?xml version="1.0" encoding="utf-8"?>
<!--
    The -v26 on this folder stays, and lint is wrong about it. ObsoleteSdkInt says to merge into
    plain mipmap-anydpi because minSdk is already 26, and doing that makes AAPT2 fail the build
    with "resource mipmap/ic_launcher not found": it does not pick the folder up at all. Tried,
    and reverted. The warning is the cheaper of the two.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
